---
import { testimonials } from '../data/testimonials';
import { site } from '../data/site';
---

<section class="voices" id="stimmen">
  <div class="container">
    <h2 class="section-title voices__title">Das sagen unsere Leser:innen</h2>
    <div class="voices__grid">
      {
        testimonials.map((t) => (
          <figure class="voices__card">
            <blockquote>{t.quote}</blockquote>
            <figcaption>–– {t.author}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="voices__cta">
      <a class="btn btn--sm" href={site.orderUrl} target="_blank" rel="noopener">Jetzt bestellen</a>
    </div>
  </div>
</section>

<style>
  .voices {
    padding-block: var(--section-y) 40px;
  }

  .voices__title {
    padding-inline: 10px;
  }

  .voices__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 16px;
    max-width: 1106px;
    margin-top: 40px;
  }

  .voices__card {
    margin: 0;
    padding: 50px 50px 64px 52px;
    background: #fff;
    border: 1px solid #f0edf0;
    box-shadow: 5px 5px 0 var(--c-mauve-accent);
  }

  /* A lone final card spans the full row, like the original */
  .voices__card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .voices__card blockquote {
    margin: 0;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--c-plum);
  }

  .voices__card figcaption {
    margin-top: 20px;
    font-size: 13px;
    color: var(--c-plum);
  }

  .voices__cta {
    margin-top: 44px;
    text-align: center;
  }

  @media (max-width: 767px) {
    .voices__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .voices__card {
      padding: 28px 24px 36px;
    }
  }
</style>
