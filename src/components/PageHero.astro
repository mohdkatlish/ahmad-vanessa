---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-hero">
  <h1 class="enter" style="--delay: 0.05s">{title}</h1>
</header>

<style>
  .page-hero {
    margin-top: 64px;
    padding: 36px var(--gutter);
    background: #f5f5f5;
    text-align: center;
  }

  .page-hero h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 80px);
    line-height: 1.1;
    color: #161922;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
</style>
