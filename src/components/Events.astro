---
import { events, eventsIntro, eventsTitle } from '../data/events';
---

<section class="events" id="lesungen">
  <div class="container">
    <h2 class="section-title events__title reveal">{eventsTitle}</h2>
    {eventsIntro && <p class="events__intro reveal" style="--delay: 0.1s;">{eventsIntro}</p>}
    <ul class="events__list">
      {
        events.map((e) => (
          <li class="events__row reveal">
            <h3 class="events__place">
              {e.date} {e.city}
            </h3>
            <p class="events__venue">{e.venue}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .events {
    padding-block: var(--section-y);
  }

  .events__title {
    padding-inline: 10px;
    margin-bottom: 28px;
  }

  .events__intro {
    max-width: 640px;
    padding: 16px 10px 28px;
    font-size: 17px;
    color: var(--c-plum);
  }

  .events__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .events__row {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 4px 24px;
    align-items: baseline;
    padding: 32px 10px;
    border-bottom: 1px solid var(--c-line);
  }

  .events__place {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 28px);
    color: var(--c-plum-dark);
  }

  .events__venue {
    font-weight: 600;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.4;
    color: var(--c-mauve-ink);
  }

  @media (max-width: 767px) {
    .events__row {
      grid-template-columns: 1fr;
      padding-block: 20px;
    }
  }
</style>
