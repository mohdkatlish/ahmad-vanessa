---
import { Image } from 'astro:assets';
import cover from '../assets/book-cover.jpg';
import { book } from '../data/book';

// Everything is sized from the real book's proportions; --bw (rendered width) is set in CSS.
const vars = [
  `--ratio-h: ${book.heightMm / book.widthMm}`,
  `--ratio-d: ${book.depthMm / book.widthMm}`,
  `--ratio-board: ${book.boardMm / book.widthMm}`,
  `--ratio-squares: ${book.squaresMm / book.widthMm}`,
  `--hinge: ${((book.hingeMm / book.widthMm) * 100).toFixed(2)}%`,
].join('; ');
---

<div class="book-scene" data-book style={vars}>
  <div class="book-shadow" aria-hidden="true"></div>
  <!-- .book-enter carries the one-time entrance; .book carries the resting angle and pointer tilt -->
  <div class="book-enter">
    <div class:list={['book', { 'book--gloss': book.finish === 'gloss' }]}>
      <div class="book__face book__front">
        <Image
          src={cover}
          alt="Buchcover: Vanessa Vu, Ahmad Katlesh – Komm dahin, wo es still ist. Eine Erkundung"
          widths={[360, 540, 720, 1080]}
          sizes="(max-width: 767px) 60vw, 380px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="book__face book__spine" aria-hidden="true">
        {
          book.spine ? (
            <Image src={book.spine} alt="" widths={[80, 160]} sizes="60px" loading="eager" />
          ) : (
            <div class="book__spine-print">
              <span class="book__spine-authors">Vu · Katlesh</span>
              <span class="book__spine-title">
                <span class="book__spine-komm">Komm dahin,</span> <span class="book__spine-still">wo es still ist</span>
              </span>
              <span class="book__spine-logo">rororo</span>
            </div>
          )
        }
      </div>

      <div class="book__face book__back" aria-hidden="true">
        {book.back && <Image src={book.back} alt="" width={540} />}
      </div>

      <!-- Edges of the two cover boards (hardcover) -->
      <div class="book__face book__board book__board--side book__board--front" aria-hidden="true"></div>
      <div class="book__face book__board book__board--side book__board--back" aria-hidden="true"></div>
      <div class="book__face book__board book__board--top book__board--front" aria-hidden="true"></div>
      <div class="book__face book__board book__board--top book__board--back" aria-hidden="true"></div>
      <div class="book__face book__board book__board--bottom book__board--front" aria-hidden="true"></div>
      <div class="book__face book__board book__board--bottom book__board--back" aria-hidden="true"></div>

      <!-- Page block, sitting slightly inside the boards -->
      <div class="book__face book__pages book__pages--side" aria-hidden="true"></div>
      <div class="book__face book__pages book__pages--top" aria-hidden="true"></div>
      <div class="book__face book__pages book__pages--bottom" aria-hidden="true"></div>
    </div>
  </div>
</div>

<script>
  // Gentle tilt that follows the pointer — only for fine pointers and when motion is welcome.
  const scene = document.querySelector<HTMLElement>('[data-book]');
  const area = scene?.closest('section') ?? document.body;
  const canTilt =
    matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && canTilt) {
    let frame = 0;
    area.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = area.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        scene.style.setProperty('--tilt-y', `${(x * 16).toFixed(2)}deg`);
        scene.style.setProperty('--tilt-x', `${(-y * 8).toFixed(2)}deg`);
      });
    });
    area.addEventListener('pointerleave', () => {
      scene.style.setProperty('--tilt-y', '0deg');
      scene.style.setProperty('--tilt-x', '0deg');
    });
  }
</script>

<style>
  .book-scene {
    /* Rendered size of the front cover; everything else follows the real proportions. */
    --bw: clamp(220px, 26vw, 360px);
    --bh: calc(var(--bw) * var(--ratio-h));
    --bd: calc(var(--bw) * var(--ratio-d));
    --board: max(3px, calc(var(--bw) * var(--ratio-board)));
    --squares: max(1px, calc(var(--bw) * var(--ratio-squares)));
    --paper: #f6f1e7;
    --cover-bg: #f7ece4;
    --board-edge: #e9dcd3;
    --tilt-x: 0deg;
    --tilt-y: 0deg;

    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding-block: 24px 48px;
    perspective: 1600px;
  }

  .book-enter {
    transform-style: preserve-3d;
    animation: book-in 1.5s cubic-bezier(0.16, 0.84, 0.3, 1) 0.25s both;
  }

  /* The book turns into its resting angle and settles, as if set down */
  @keyframes book-in {
    from {
      opacity: 0;
      transform: translateY(28px) rotateY(-38deg) rotateX(-6deg);
    }
    35% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .book {
    position: relative;
    width: var(--bw);
    height: var(--bh);
    transform-style: preserve-3d;
    /* Seen slightly from above, like a book on a table: the top edge shows, the underside doesn't */
    transform: rotateX(calc(-5deg + var(--tilt-x))) rotateY(calc(28deg + var(--tilt-y)));
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .book__face {
    position: absolute;
    backface-visibility: hidden;
  }

  /* ---------- Front cover ---------- */
  .book__front {
    inset: 0;
    transform: translateZ(calc(var(--bd) / 2));
    border-radius: 0 2px 2px 0;
    overflow: hidden;
    background: var(--cover-bg);
  }

  .book__front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hinge groove near the spine + soft light fall-off across the cover */
  .book__front::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(0 0 0 / 0.1) 0,
        rgb(0 0 0 / 0.02) calc(var(--hinge) - 1.2%),
        rgb(0 0 0 / 0.1) calc(var(--hinge) - 0.4%),
        rgb(0 0 0 / 0.16) var(--hinge),
        rgb(255 255 255 / 0.35) calc(var(--hinge) + 0.5%),
        rgb(255 255 255 / 0.08) calc(var(--hinge) + 1.2%),
        transparent calc(var(--hinge) + 1.8%)
      ),
      linear-gradient(100deg, transparent 55%, rgb(0 0 0 / 0.06));
    pointer-events: none;
  }

  .book--gloss .book__front::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.28) 45%, transparent 60%);
    pointer-events: none;
  }

  /* ---------- Back cover ---------- */
  .book__back {
    inset: 0;
    transform: rotateY(180deg) translateZ(calc(var(--bd) / 2));
    background: var(--cover-bg);
    overflow: hidden;
  }

  .book__back img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Spine (left side), full thickness incl. boards ---------- */
  .book__spine {
    top: 0;
    left: calc((var(--bw) - var(--bd)) / 2);
    width: var(--bd);
    height: var(--bh);
    transform: rotateY(-90deg) translateZ(calc(var(--bw) / 2));
    background: var(--cover-bg);
    border-radius: 2px;
    overflow: hidden;
  }

  /* Rounded-spine shading */
  .book__spine::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.12), rgb(255 255 255 / 0.06) 35%, rgb(0 0 0 / 0.02) 65%, rgb(0 0 0 / 0.14));
    pointer-events: none;
  }

  .book__spine img {
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  /* Fallback spine (no photo): text reads bottom-to-top, as on German books */
  .book__spine-print {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: var(--bh);
    height: var(--bd);
    padding-inline: calc(var(--bh) * 0.05);
    transform: translateY(var(--bh)) rotate(-90deg);
    transform-origin: 0 0;
    font-family: var(--f-body);
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
    font-size: calc(var(--bd) * 0.26);
    line-height: 1;
  }

  .book__spine-logo {
    padding: 0.35em 0.4em;
    background: #8d8290;
    color: #fff;
    font-size: 0.7em;
    text-transform: lowercase;
  }

  .book__spine-komm {
    color: #7e6d82;
  }

  .book__spine-still {
    color: #c9a18c;
  }

  .book__spine-authors {
    color: #3f3842;
    font-size: 0.72em;
    letter-spacing: 0.08em;
  }

  /* ---------- Board edges (hardcover boards are ~2.5 mm thick) ---------- */
  .book__board {
    background: var(--board-edge);
  }

  /* Open side (fore-edge) of each board */
  .book__board--side {
    top: 0;
    left: calc((var(--bw) - var(--board)) / 2);
    width: var(--board);
    height: var(--bh);
    background: linear-gradient(90deg, var(--board-edge), #f3e8e0);
  }

  .book__board--side.book__board--front {
    transform: translateX(calc(var(--bw) / 2)) translateZ(calc(var(--bd) / 2 - var(--board) / 2)) rotateY(90deg);
  }

  .book__board--side.book__board--back {
    transform: translateX(calc(var(--bw) / 2)) translateZ(calc(var(--board) / 2 - var(--bd) / 2)) rotateY(90deg);
  }

  /* Top and bottom edges of each board */
  .book__board--top,
  .book__board--bottom {
    left: 0;
    top: calc((var(--bh) - var(--board)) / 2);
    width: var(--bw);
    height: var(--board);
  }

  .book__board--top.book__board--front {
    transform: translateY(calc(var(--bh) / -2)) translateZ(calc(var(--bd) / 2 - var(--board) / 2)) rotateX(90deg);
  }

  .book__board--top.book__board--back {
    transform: translateY(calc(var(--bh) / -2)) translateZ(calc(var(--board) / 2 - var(--bd) / 2)) rotateX(90deg);
  }

  .book__board--bottom.book__board--front {
    transform: translateY(calc(var(--bh) / 2)) translateZ(calc(var(--bd) / 2 - var(--board) / 2)) rotateX(-90deg);
  }

  .book__board--bottom.book__board--back {
    transform: translateY(calc(var(--bh) / 2)) translateZ(calc(var(--board) / 2 - var(--bd) / 2)) rotateX(-90deg);
  }

  /* ---------- Page block: recessed between the boards, fine paper lines ---------- */
  .book__pages {
    background-color: var(--paper);
  }

  .book__pages--side {
    top: var(--squares);
    left: calc((var(--bw) - (var(--bd) - 2 * var(--board))) / 2);
    width: calc(var(--bd) - 2 * var(--board));
    height: calc(var(--bh) - 2 * var(--squares));
    transform: rotateY(90deg) translateZ(calc(var(--bw) / 2 - var(--squares)));
    background-image:
      repeating-linear-gradient(90deg, rgb(120 100 80 / 0.14) 0 1px, transparent 1px 2.5px),
      linear-gradient(90deg, rgb(0 0 0 / 0.16), transparent 18%, transparent 82%, rgb(0 0 0 / 0.16));
  }

  .book__pages--top,
  .book__pages--bottom {
    left: 0;
    width: calc(var(--bw) - var(--squares));
    height: calc(var(--bd) - 2 * var(--board));
    top: calc((var(--bh) - (var(--bd) - 2 * var(--board))) / 2);
    background-image:
      repeating-linear-gradient(0deg, rgb(120 100 80 / 0.14) 0 1px, transparent 1px 2.5px),
      linear-gradient(0deg, rgb(0 0 0 / 0.12), transparent 25%, transparent 75%, rgb(0 0 0 / 0.12));
  }

  .book__pages--top {
    transform: rotateX(90deg) translateZ(calc(var(--bh) / 2 - var(--squares)));
  }

  .book__pages--bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--bh) / 2 - var(--squares)));
  }

  /* ---------- Soft contact shadow on the "table" ---------- */
  .book-shadow {
    position: absolute;
    bottom: 26px;
    left: 50%;
    width: calc(var(--bw) * 1.05);
    height: 34px;
    transform: translateX(-44%);
    background: radial-gradient(closest-side, rgb(36 36 35 / 0.45), transparent);
    filter: blur(8px);
    pointer-events: none;
    animation: shadow-in 1.5s cubic-bezier(0.16, 0.84, 0.3, 1) 0.25s both;
  }

  @keyframes shadow-in {
    from {
      opacity: 0;
      transform: translateX(-44%) scaleX(0.7);
    }
  }

  @media (max-width: 767px) {
    .book-scene {
      --bw: min(58vw, 260px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      transition: none;
    }

    .book-enter,
    .book-shadow {
      animation: none;
    }
  }
</style>
