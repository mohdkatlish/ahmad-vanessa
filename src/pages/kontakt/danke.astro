---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="Danke" noindex>
  <PageHero title="Danke" />
  <div class="container thanks">
    <p>Danke für Ihre Nachricht! Wir melden uns so bald wie möglich.</p>
    <a class="btn" href="/">Zur Startseite</a>
  </div>
</Base>

<style>
  .thanks {
    display: grid;
    justify-items: start;
    gap: 32px;
    padding-block: 100px var(--section-y);
    font-size: 17px;
  }
</style>
